# Relais Quai : variables d'environnement (sur Vercel : Settings > Environment Variables, puis redéployer).
# Ne jamais committer de vraie clé : ce fichier est un modèle.

# Obligatoire en production : clé gratuite du portail Belgian Mobility Company (produit « Standard »).
# https://api-management-opendata-production.developer.azure-api.net/
BMC_KEY=

# Optionnelle : base du portail (défaut ci-dessous). En local avec le faux portail : http://localhost:8789
BMC_BASE=https://api-management-opendata-production.azure-api.net

# Optionnelle : flux GTFS-RT SNCB direct fourni par la SNCB sur demande (plus complet que la copie BMC).
# Si elle est définie, /api/rt?op=sncb l'utilise (sans envoyer la clé BMC à cette adresse).
SNCB_RT_URL=

# Optionnelle : base des données de nuit (GitHub Pages), pour que /api/health lise meta.json.
# Exemple : https://<utilisateur>.github.io/<depot>/data
DATA_BASE=

# Adresses (GET /api/geocode) : services officiels sans clé, rien à définir en temps normal.
# Services activés, dans l'ordre (défaut vla,bru,wal ; google est ignoré en 1.1).
GEOCODE_SOURCES=
# Adresses de base, seulement pour suivre un changement de version d'un service (défauts dans relay/README.md).
QUAI_GEO_VLA_BASE=
QUAI_GEO_BRU_BASE=
QUAI_GEO_WAL_BASE=
# Tests seulement (faux service d'adresses, npm run mock-geocode), jamais sur Vercel : QUAI_GEO_BASE=http://localhost:8790
# Google n'est pas branché en 1.1 : laisser vide.
GOOGLE_GEOCODING_KEY=
