{
  "name": "quai-app",
  "private": true,
  "version": "1.2.0",
  "description": "Quai : horaires des transports en commun belges en temps réel sur les lunettes Even Realities G2",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "configure": "node scripts/configure.mjs",
    "pack": "node scripts/check-configured.mjs && npm run build && evenhub pack app.json dist -o quai.ehpk --sdk-ver 0.0.16",
    "sim-tour": "node scripts/sim-tour.mjs",
    "icons:web": "node scripts/make-web-icons.mjs"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16",
    "@evenrealities/pretext": "^0.1.4"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@types/node": "^22.20.5",
    "happy-dom": "21.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
